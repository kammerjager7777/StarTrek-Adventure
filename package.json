{
  "name": "star-trek-adventure",
  "version": "0.1.0",
  "private": true,
  "description": "Star Trek Adventure — AI Gamemaster text adventure with extensible agents, skills, and tools",
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/src/index.ts",
    "start": "tsx server/src/index.ts",
    "typecheck": "tsc --noEmit",
    "test:campaign": "tsx scripts/smoke-campaign-types.mts",
    "test:profiles": "tsx scripts/smoke-profile-persist.mts",
    "test:crew": "tsx scripts/smoke-crew-lifecycle.mts",
    "test:shields": "tsx scripts/smoke-shield-leak.mts",
    "test:skills": "tsx scripts/smoke-skills.mts",
    "test:universe": "tsx scripts/smoke-universe.mts",
    "test:advice": "tsx scripts/smoke-advice.mts",
    "test:voices": "tsx scripts/smoke-voice-gender.mts",
    "test:starbase": "tsx scripts/smoke-starbase.mts",
    "test:skillpacks": "tsx scripts/smoke-skill-packs.mts",
    "test:phase8": "tsx scripts/smoke-phase8.mts"
