# Get a key at https://console.x.ai
XAI_API_KEY=your_xai_api_key_here

# Optional overrides
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.5
# XAI_IMAGE_MODEL=grok-imagine-image-quality

# Local server
PORT=3000
HOST=127.0.0.1

# Production (Cloud Run sets PORT; HOST must be 0.0.0.0)
# NODE_ENV=production
# HOST=0.0.0.0

# Games require a working XAI_API_KEY — there is no mock narrator fallback
# GCP: secret lives in Secret Manager as XAI_API_KEY (see deploy/gcp/README.md)

# Access gate. Production requires Google Sign-In.
# ALLOWED_USERS=*                # any Google account (current)
# ALLOWED_USERS=you@gmail.com    # restrict to a comma-separated list instead
# ACCESS_CONTACT_EMAIL=michaelstephens2011@gmail.com
# GOOGLE_CLIENT_ID=....apps.googleusercontent.com
# SESSION_SECRET=generate-a-long-random-string

# Dev feedback inbox (Google Sheet + GCS screenshots). Leave unset to save under data/feedback/.
# GOOGLE_SA_JSON={"type":"service_account",...}
# or GOOGLE_SA_JSON_FILE=/path/to/sa.json
# FEEDBACK_SHEET_ID=...
# FEEDBACK_SHEET_TAB=Sheet1
# FEEDBACK_GCS_BUCKET=sta-feedback-3524d3
# FEEDBACK_PUBLIC_BASE=https://sta-bridge-ledmkjy2mq-uc.a.run.app
